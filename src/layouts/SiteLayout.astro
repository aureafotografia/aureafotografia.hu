---
import { photographer, type Locale } from "../data/site";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonicalPath?: string;
  alternatePath?: string;
  socialImage?: string;
  socialImageAlt?: string;
  structuredData?: Record<string, unknown>;
}

const { locale, title, description, canonicalPath, alternatePath, socialImage = "/images/aurea-logo.png", socialImageAlt = title, structuredData } = Astro.props;
const siteUrl = "https://aureafotografia.hu";
const defaultPath = locale === "hu" ? "/" : "/en";
const defaultAlternatePath = locale === "hu" ? "/en" : "/";
const canonical = new URL(canonicalPath ?? defaultPath, siteUrl).href;
const alternate = new URL(alternatePath ?? defaultAlternatePath, siteUrl).href;
const socialImageUrl = new URL(socialImage, siteUrl).href;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={photographer.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Marcellus&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={locale === "hu" ? "en" : "hu"} href={alternate} />
    <link rel="alternate" hreflang="x-default" href="https://aureafotografia.hu/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={photographer.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "hu" ? "hu_HU" : "en_GB"} />
    <meta property="og:locale:alternate" content={locale === "hu" ? "en_GB" : "hu_HU"} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="2390" />
    <meta property="og:image:height" content="3585" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      document.querySelectorAll<HTMLDetailsElement>("details.nav-menu, details.language-menu").forEach((menu) => {
        let closeTimer: number | undefined;
        const openMenu = () => {
          window.clearTimeout(closeTimer);
          menu.open = true;
        };
        const closeMenu = () => {
          window.clearTimeout(closeTimer);
          closeTimer = window.setTimeout(() => {
            if (!menu.matches(":focus-within")) menu.open = false;
          }, 260);
        };

        menu.addEventListener("pointerenter", openMenu);
        menu.addEventListener("pointerleave", closeMenu);
        menu.addEventListener("focusin", openMenu);
        menu.addEventListener("focusout", (event) => {
          if (!(event.relatedTarget instanceof Node) || !menu.contains(event.relatedTarget)) closeMenu();
        });
      });
    </script>
  </body>
</html>
