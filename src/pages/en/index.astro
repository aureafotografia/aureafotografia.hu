---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { copy, photographer } from "../../data/site";
import { categories } from "../../data/categories";
import ContactSection from "../../components/ContactSection.astro";
import SiteNav from "../../components/SiteNav.astro";
import "../../styles/global.css";

const content = copy.en;
const description = "Aurea Fotográfia — wedding, portrait and lifestyle photography in Budapest and beyond.";
const image = "/images/homepage/about-alexandra.jpg";
const heroImage = "/images/homepage/hero.jpg";
const homepageCategorySlugs = ["eskuvo-fotozas", "kismama-fotozas", "uzleti-portre", "csaladi-fotozas", "paros-fotozas", "sport-fotozas"];
const homepageCategories = homepageCategorySlugs.map((slug) => categories.find((category) => category.slug === slug)!);
const categoryImages: Record<string, string> = {
  "eskuvo-fotozas": "/images/homepage/wedding.jpg",
  "kismama-fotozas": "/images/homepage/maternity.jpg",
  "uzleti-portre": "/images/homepage/business.jpg",
  "csaladi-fotozas": "/images/homepage/family.jpg",
  "paros-fotozas": "/images/homepage/couple.jpg",
  "sport-fotozas": "/images/homepage/sport.jpg",
};
const testimonials = ["Alexandra was present as if she had always belonged there. Every important moment is waiting for us in the photographs.", "Natural, sensitive and wonderfully attentive work. These are exactly the memories we hoped to bring home.", "We did not just receive photographs, but a story about how it felt to be together that day."];
---

<SiteLayout locale="en" title={`${photographer.brand} · Photography`} description={description}>
  <div class="site-shell reference-home">
    <SiteNav locale="en" />
    <main>
      <section class="reference-hero" aria-label="Aurea Fotográfia"><div class="hero-panel hero-panel--main" style={`background-image: url(${heroImage})`}></div><div class="hero-overlay"><p class="eyebrow">{content.heroEyebrow}</p><h1 id="hero-title">{content.heroTitle.replaceAll("\n", " ")}</h1></div></section>
      <section class="reference-intro" id="about" aria-labelledby="hero-title"><p>{content.heroBody}</p></section>
      <section class="story-grid container" id="work" aria-label="Selected stories">{homepageCategories.map((category, index) => <a class={`story-card story-card--${index + 1}`} href={`/en/work/${category.slugEn}`}><img src={categoryImages[category.slug]} alt={`${category.en.title} photograph`} loading={index > 1 ? "lazy" : "eager"} /><span>{category.en.title}</span><small>{category.en.meta}</small></a>)}</section>
      <section class="about-section container" aria-labelledby="about-title"><div class="about-image"><img src={image} alt="Alexandra holding a camera outdoors" loading="lazy" /></div><div class="about-copy"><p class="eyebrow">{content.introLabel}</p><p class="about-kicker" id="about-title">{content.introTitle}</p><p>{content.introBody}</p></div></section>
      <section class="testimonials-section" aria-labelledby="testimonials-title"><div class="container"><p class="eyebrow">Testimonials</p><h2 id="testimonials-title">What couples say</h2><div class="testimonial-grid">{testimonials.map((testimonial) => <blockquote>“{testimonial}”</blockquote>)}</div></div></section>
      <ContactSection locale="en" />
    </main>
    <footer class="site-footer container"><div class="footer-row"><span class="footer-meta">{content.footerNote}</span><div class="footer-links"><a href={photographer.instagram}>Instagram</a><a href={`mailto:${photographer.email}`}>E-mail</a></div></div></footer>
  </div>
</SiteLayout>

<script>
  const hero = document.querySelector(".reference-hero");
  const panel = hero?.querySelector<HTMLElement>(".hero-panel--main");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let frame = 0;

  const updateParallax = () => {
    frame = 0;
    if (!hero || !panel || reducedMotion.matches) return;
    const bounds = hero.getBoundingClientRect();
    const progress = Math.max(0, Math.min(1, (window.innerHeight - bounds.top) / (window.innerHeight + bounds.height)));
    const shift = (progress - 0.5) * 220;
    const scale = window.innerWidth <= 800 ? 1.12 : 1.22;
    panel.style.transform = `scale(${scale}) translate3d(0, ${shift}px, 0)`;
  };

  const requestParallax = () => {
    if (!frame) frame = window.requestAnimationFrame(updateParallax);
  };

  window.addEventListener("scroll", requestParallax, { passive: true });
  window.addEventListener("resize", requestParallax);
  reducedMotion.addEventListener("change", requestParallax);
  requestParallax();
</script>
