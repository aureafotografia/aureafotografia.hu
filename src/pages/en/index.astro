---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { copy, photographer } from "../../data/site";
import { categories } from "../../data/categories";
import ContactSection from "../../components/ContactSection.astro";
import SiteNav from "../../components/SiteNav.astro";
import { Picture } from "astro:assets";
import { homepageAboutImage, homepageCategoryImages, homepageHeroImage } from "../../data/homepage-images";
import "../../styles/global.css";

const content = copy.en;
const description = "Wedding, couples, maternity, family, business portrait and sports photography in Budapest and beyond. Natural light and a thoughtful, personal approach by Aurea Fotográfia.";
const homepageCategorySlugs = ["eskuvo-fotozas", "kismama-fotozas", "uzleti-portre", "csaladi-fotozas", "paros-fotozas", "sport-fotozas"];
const homepageCategories = homepageCategorySlugs.map((slug) => categories.find((category) => category.slug === slug)!);
const testimonials = ["Alexandra was present as if she had always belonged there. Every moment that mattered to us comes back in the photographs.", "Natural, sensitive and wonderfully attentive work. These are exactly the memories we hoped to bring home.", "We did not just receive photographs, but a story about how it felt to be together that day."];
---

<SiteLayout locale="en" title={`${photographer.brand} · Photography`} description={description}>
  <div class="site-shell reference-home">
    <SiteNav locale="en" />
    <main>
      <section class="reference-hero" aria-label="Aurea Fotográfia"><Picture src={homepageHeroImage} alt="" width={2400} widths={[800, 1200, 1600, 2400]} sizes="100vw" formats={["avif", "webp"]} fallbackFormat="jpg" loading="eager" fetchpriority="high" decoding="async" pictureAttributes={{ class: "hero-panel hero-panel--main" }} /><div class="hero-overlay"><p class="eyebrow">{content.heroEyebrow}</p><h1 id="hero-title">{content.heroTitle.replaceAll("\n", " ")}</h1><p class="hero-subtitle">{content.heroSubtitle}</p></div></section>
      <section class="reference-intro" aria-labelledby="hero-title"><p>{content.heroBody}</p></section>
      <section class="story-grid container" id="work" aria-label="Selected stories">{homepageCategories.map((category, index) => <a class={`story-card story-card--${index + 1}`} href={`/en/work/${category.slugEn}/`}><Picture src={homepageCategoryImages[category.slug as keyof typeof homepageCategoryImages]} alt={`${category.en.title} photograph`} width={1200} widths={[480, 800, 1200]} sizes="(max-width: 520px) 100vw, (max-width: 800px) 50vw, 33vw" formats={["avif", "webp"]} fallbackFormat="jpg" loading={index > 1 ? "lazy" : "eager"} decoding="async" fetchpriority="low" /><span>{category.en.title}</span><small>{category.en.meta}</small></a>)}</section>
      <section class="about-section container" id="about" aria-labelledby="about-title"><div class="about-image"><Picture src={homepageAboutImage} alt="Alexandra holding a camera outdoors" width={1200} widths={[480, 800, 1200]} sizes="(max-width: 800px) 100vw, 45vw" formats={["avif", "webp"]} fallbackFormat="jpg" loading="lazy" decoding="async" /></div><div class="about-copy"><p class="eyebrow">{content.introLabel}</p><p class="about-kicker" id="about-title">{content.introTitle}</p><p>{content.introBody}</p></div></section>
      <section class="testimonials-section" aria-labelledby="testimonials-title"><div class="container"><p class="eyebrow">Testimonials</p><h2 id="testimonials-title">What couples say</h2><div class="testimonial-grid">{testimonials.map((testimonial) => <blockquote>“{testimonial}”</blockquote>)}</div></div></section>
      <ContactSection locale="en" />
    </main>
    <footer class="site-footer container"><div class="footer-row"><span class="footer-meta">Copyright 2026</span><div class="footer-links"><span>Contact:</span><a href={photographer.instagram} target="_blank" rel="noreferrer">instagram.com/aurea_fotografia_</a><a href={`mailto:${photographer.email}`}>{photographer.email}</a></div></div></footer>
  </div>
</SiteLayout>

<script>
  const hero = document.querySelector(".reference-hero");
  const panel = hero?.querySelector<HTMLElement>(".hero-panel--main");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let frame = 0;

  const updateParallax = () => {
    frame = 0;
    if (!hero || !panel || reducedMotion.matches) {
      if (panel) panel.style.transform = `scale(${window.innerWidth <= 800 ? 1.12 : 1.22})`;
      return;
    }
    const bounds = hero.getBoundingClientRect();
    const progress = Math.max(0, Math.min(1, (window.innerHeight - bounds.top) / (window.innerHeight + bounds.height)));
    const shift = (progress - 0.5) * 220;
    const scale = window.innerWidth <= 800 ? 1.12 : 1.22;
    panel.style.transform = `scale(${scale}) translate3d(0, ${shift}px, 0)`;
  };

  const requestParallax = () => {
    if (!frame) frame = window.requestAnimationFrame(updateParallax);
  };

  window.addEventListener("scroll", requestParallax, { passive: true });
  window.addEventListener("resize", requestParallax);
  reducedMotion.addEventListener("change", requestParallax);
  requestParallax();
</script>
