---
import SiteLayout from "../layouts/SiteLayout.astro";
import SiteNav from "./SiteNav.astro";
import ContactSection from "./ContactSection.astro";
import { photographer, type Locale } from "../data/site";
import "../styles/global.css";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const hu = locale === "hu";
const title = hu ? "Árak" : "Prices";
const description = hu
  ? "Fotózási csomagok és árak. Válaszd ki az elképzeléseidhez illő csomagot, és tervezzük meg együtt a fotózást."
  : "Photography packages and prices. Choose a package that suits your needs and let’s plan your session together.";
const packages = hu ? [
  { name: "Mini", price: "39 000 HUF", description: "Könnyed fotózás egy kisebb, gondosan válogatott képsorozathoz.", includes: ["1 szett", "10–12 szerkesztett fotó", "Online galéria"] },
  { name: "Standard", price: "59 000 HUF", description: "Több lehetőség és változatosabb képek az elképzeléseidhez igazítva.", includes: ["2–3 szett", "20–24 szerkesztett fotó", "Online galéria"] },
  { name: "Signature", price: "79 000 HUF", description: "Egy átfogó képsorozat, több térrel az ötleteknek és a részleteknek.", includes: ["Több szett", "36+ szerkesztett fotó", "Online galéria"] },
] : [
  { name: "Mini", price: "39 000 HUF", description: "A relaxed session for a small, carefully curated collection of images.", includes: ["1 outfit", "10–12 edited photographs", "Online gallery"] },
  { name: "Standard", price: "59 000 HUF", description: "More possibilities and a varied collection tailored to your ideas.", includes: ["2–3 outfits", "20–24 edited photographs", "Online gallery"] },
  { name: "Signature", price: "79 000 HUF", description: "A comprehensive collection with more room for ideas and details.", includes: ["Multiple outfits", "36+ edited photographs", "Online gallery"] },
];
---

<SiteLayout locale={locale} title={`${title} · ${photographer.brand}`} description={description} canonicalPath={hu ? "/arak" : "/en/prices"} alternatePath={hu ? "/en/prices" : "/arak"}>
  <div class="site-shell category-shell">
    <SiteNav locale={locale} pricesPage />
    <main>
      <section class="page-section category-reference-intro" aria-labelledby="prices-title">
        <div class="page-section__inner">
          <div class="category-reference-intro__copy">
            <p class="eyebrow">{hu ? "Csomagok és árak" : "Packages and pricing"}</p>
            <h1 id="prices-title">{title}</h1>
            <p>{description}</p>
          </div>
        </div>
      </section>
      <section class="page-section category-packages" aria-labelledby="prices-packages-title">
        <div class="page-section__inner">
          <div class="category-packages-heading">
            <p class="eyebrow">{hu ? "Fotózási csomagok" : "Photography packages"}</p>
            <h2 id="prices-packages-title">{hu ? "Válaszd azt, ami hozzád illik." : "Choose what feels right for you."}</h2>
          </div>
          <div class="category-packages-grid">
            {packages.map((pkg, index) => (
              <article class={`category-package-card${index === 1 ? " category-package-card--featured" : ""}`}>
                <h3>{pkg.name}</h3>
                <p class="category-package-description">{pkg.description}</p>
                <p class="category-package-price">{pkg.price}</p>
                <div class="category-package-details">
                  <ul>{pkg.includes.map((item) => <li>{item}</li>)}</ul>
                  <a class="button-link" href="#prices-contact">{hu ? "Foglalás" : "Book now"}</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
      <ContactSection locale={locale} id="prices-contact" />
    </main>
    <footer class="site-footer container">
      <div class="footer-row">
        <span class="footer-meta">Copyright 2026</span>
        <div class="footer-links">
          <span>{hu ? "Kapcsolat:" : "Contact:"}</span>
          <a href={photographer.instagram} target="_blank" rel="noreferrer">instagram.com/aurea_fotografia_</a>
          <a href={`mailto:${photographer.email}`}>{photographer.email}</a>
        </div>
      </div>
    </footer>
  </div>
</SiteLayout>
