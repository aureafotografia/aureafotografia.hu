---
import type { Locale } from "../data/site";

interface Props {
  locale: Locale;
  buttonLabel?: string;
}

const { locale, buttonLabel } = Astro.props;
const isHungarian = locale === "hu";
// Web3Forms access keys are intentionally public client-side form identifiers.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY || "433e436b-65eb-404c-a3aa-d66827662729";
---

<form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={isHungarian ? "Új megkeresés az Aurea Fotográfiától" : "New inquiry from Aurea Fotográfia"} />
  <input type="hidden" name="from_name" value="Aurea Fotográfia website" />
  <input type="hidden" name="redirect" value={isHungarian ? "https://aureafotografia.hu/#contact-sent" : "https://aureafotografia.hu/en#contact-sent"} />
  <input class="contact-form__trap" type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />

  <div class="contact-form__row">
    <label>
      <span>{isHungarian ? "Név" : "Name"}</span>
      <input type="text" name="name" autocomplete="name" required />
    </label>
    <label>
      <span>{isHungarian ? "E MAIL" : "Email"}</span>
      <input type="email" name="email" autocomplete="email" required />
    </label>
  </div>
  <label>
    <span>{isHungarian ? "Miben segíthetek?" : "Tell me about your plans"}</span>
    <textarea name="message" rows="5" required></textarea>
  </label>
  <button class="button-link contact-form__submit" type="submit">{buttonLabel ?? (isHungarian ? "Üzenet küldése" : "Send inquiry")}</button>
</form>
