---
import { type Locale } from "../data/site";
import ContactForm from "./ContactForm.astro";

interface Props {
  locale: Locale;
  id?: string;
}

const { locale, id } = Astro.props;
const isHungarian = locale === "hu";
const contactId = id ?? (isHungarian ? "csomagok" : "packages");
---

<section class="contact-section container" id={contactId} aria-labelledby={`${contactId}-title`}>
  <p class="eyebrow">{isHungarian ? "Kapcsolat" : "Contact"}</p>
  <h2 id={`${contactId}-title`}>{isHungarian ? "Meséljetek arról, ami most fontos." : "Tell me what matters right now."}</h2>
  <p class="contact-lead">{isHungarian ? "Minden fotózás más ritmusú. Írjatok pár sort, és találjuk meg együtt a hozzátok illő történetet." : "Every session has its own rhythm. Write a few lines and we will find the right story together."}</p>
  <ContactForm locale={locale} />
</section>
