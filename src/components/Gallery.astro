---
import type { Locale } from "../data/site";
import galleryManifest from "../data/gallery-manifest.json";

interface Variant {
  src: string;
  width: number;
  height: number;
}

interface FormatSet {
  avif: Variant;
  webp: Variant;
  fallback: Variant;
}

interface GalleryImage {
  id: string;
  file: string;
  width: number;
  height: number;
  regular: FormatSet[];
  full: FormatSet;
}

interface Props {
  locale: Locale;
  slug: string;
  title: string;
  imageLabels?: string[];
}

const { locale, slug, title, imageLabels = [] } = Astro.props;
const galleryAliases: Record<string, string> = {
  "eskuvo-fotozas": "eskuvo",
  "uzleti-portre": "uzleti",
};
const galleryKey = galleryAliases[slug] ?? slug;
const galleryImages = (galleryManifest.galleries?.[galleryKey as keyof typeof galleryManifest.galleries] || []) as GalleryImage[];
const isHungarian = locale === "hu";
const isWedding = galleryKey === "eskuvo";
const weddingOrder = [
