---
import { googleReviews } from "../data/google-reviews";
import type { Locale } from "../data/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const formattedDate = new Date(`${googleReviews.asOfDate}T00:00:00Z`).toLocaleDateString(
  locale === "hu" ? "hu-HU" : "en-US",
  locale === "hu"
    ? { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }
    : { year: "numeric", month: "short", day: "numeric", timeZone: "UTC" },
);
const reviewLabel = locale === "hu" ? "értékelés" : "reviews";
const asOfLabel = locale === "hu" ? "állapot" : "as of";
const accessibleLabel = locale === "hu"
  ? `A(z) ${googleReviews.businessName}, ${googleReviews.location} Google-értékelései: ${googleReviews.rating} az 5-ből, ${googleReviews.reviewCount} ${reviewLabel}, ${formattedDate} állapot szerint. Megnyitás a Google Térképen új lapon.`
  : `${googleReviews.businessName}, ${googleReviews.location} Google reviews: ${googleReviews.rating} out of 5, ${googleReviews.reviewCount} ${reviewLabel}, ${asOfLabel} ${formattedDate}. Open the Google Maps listing in a new tab.`;
---

<a
  class="google-reviews-badge"
  href={googleReviews.mapsUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={accessibleLabel}
>
  <svg class="google-reviews-badge__icon" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <path fill="#4285F4" d="M43.6 24.5c0-1.6-.1-3.1-.4-4.5H24v8.5h11a9.4 9.4 0 0 1-4.1 6.2v5.5h6.7c3.9-3.6 6-9 6-15.7Z" />
    <path fill="#34A853" d="M24 44c5.5 0 10.1-1.8 13.5-4.8l-6.7-5.5c-1.8 1.2-4.1 2-6.8 2-5.3 0-9.8-3.6-11.4-8.4H5.7v5.7C9 39.5 16 44 24 44Z" />
    <path fill="#FBBC05" d="M12.6 27.3a12 12 0 0 1 0-7.6V14H5.7a20 20 0 0 0 0 18.9l6.9-5.6Z" />
    <path fill="#EA4335" d="M24 11.3c3 0 5.7 1 7.8 3.1l5.9-5.9C34.1 5.2 29.5 3 24 3 16 3 9 7.5 5.7 14l6.9 5.7c1.6-4.8 6.1-8.4 11.4-8.4Z" />
  </svg>
  <span class="google-reviews-badge__copy">
    <span class="google-reviews-badge__stars" aria-hidden="true">★★★★★</span>
    <span class="google-reviews-badge__rating">Google <strong>{googleReviews.rating}</strong></span>
    <span class="google-reviews-badge__count">{googleReviews.reviewCount} {reviewLabel} · {asOfLabel} {formattedDate}</span>
  </span>
</a>

<style>
  .google-reviews-badge {
    align-items: center;
    backdrop-filter: blur(12px);
    background: rgba(35, 39, 41, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.28);
    color: #fff;
    display: inline-flex;
    gap: 11px;
    left: 50%;
    max-width: calc(100vw - 24px);
    padding: 10px 17px 10px 13px;
    position: fixed;
    text-decoration: none;
    transform: translateX(-50%);
    transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
    white-space: nowrap;
    z-index: 1000;
  }

  .google-reviews-badge:hover {
    background: rgba(35, 39, 41, 0.97);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.32);
    transform: translate(-50%, -3px);
  }

  .google-reviews-badge:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
  }

  .google-reviews-badge__icon { flex: 0 0 32px; height: 32px; width: 32px; }
  .google-reviews-badge__copy { display: flex; flex-direction: column; gap: 0; line-height: 1.2; }
  .google-reviews-badge__stars { color: #f6c445; font-size: 15px; letter-spacing: 1px; line-height: 1.15; }
  .google-reviews-badge__rating { font-size: 13px; font-weight: 500; }
  .google-reviews-badge__rating strong { font-size: 14px; font-weight: 700; }
  .google-reviews-badge__count { color: rgba(255, 255, 255, 0.72); font-size: 10px; }

  @media (max-width: 480px) {
    .google-reviews-badge {
      bottom: calc(10px + env(safe-area-inset-bottom, 0px));
      gap: 8px;
      padding: 8px 13px 8px 10px;
    }

    .google-reviews-badge__icon { flex-basis: 27px; height: 27px; width: 27px; }
    .google-reviews-badge__stars { font-size: 13px; letter-spacing: .7px; }
    .google-reviews-badge__rating { font-size: 12px; }
    .google-reviews-badge__rating strong { font-size: 13px; }
    .google-reviews-badge__count { font-size: 9px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .google-reviews-badge { transition: none; }
  }
</style>
