---
import SiteLayout from "../layouts/SiteLayout.astro";
import { photographer, type Locale } from "../data/site";
import type { Category } from "../data/categories";
import Gallery from "./Gallery.astro";
import SiteNav from "./SiteNav.astro";
import ContactSection from "./ContactSection.astro";
import "../styles/global.css";

interface Props {
  locale: Locale;
  category: Category;
}

const { locale, category } = Astro.props;
const content = category[locale];
const isHungarian = locale === "hu";
const isWeddingCategory = category.slug === "eskuvo-fotozas";
const isWeddingPage = isWeddingCategory && isHungarian;
const isBusinessCategory = category.slug === "uzleti-portre";
const description = isWeddingPage
  ? "Editorial és dokumentarista esküvői fotózás Budapesten és a Balatonnál. Természetes pillanatok, művészi portrék és személyes történetek, akár két fotóssal."
  : isBusinessCategory
  ? isHungarian
    ? "Üzleti portré és business fotózás Budapesten: természetes, professzionális képek LinkedInhez, CV-hez, weboldalhoz és personal brandinghez."
    : "Business portrait photography in Budapest: natural, professional images for LinkedIn, CVs, websites and personal branding."
  : `${photographer.brand}, ${content.eyebrow.toLowerCase()} Budapest és környékén.`;
const pageTitle = isWeddingPage
  ? "Esküvői fotózás Budapest és Balaton | AUREA Fotográfia"
  : `${content.title} · ${photographer.brand}`;
const categoryImages: Record<string, string> = {
  "eskuvo-fotozas": "/images/generated/galleries/eskuvo/dsc07129--full--318a1bda5f.jpg",
  "kismama-fotozas": "/images/homepage/maternity.jpg",
  "uzleti-portre": "/images/homepage/business.jpg",
  "csaladi-fotozas": "/images/homepage/family.jpg",
  "paros-fotozas": "/images/homepage/couple.jpg",
  "sport-fotozas": "/images/homepage/sport.jpg",
};
const image = categoryImages[category.slug] ?? "/images/aurea-hero-wedding.png";
const isBusinessPage = isHungarian && isBusinessCategory;
const canonicalPath = isHungarian ? `/munkak/${category.slug}` : `/en/work/${category.slugEn}`;
const alternatePath = isHungarian ? `/en/work/${category.slugEn}` : `/munkak/${category.slug}`;
const socialImageAlt = isBusinessCategory
  ? isHungarian ? "Üzleti portré fotózás Budapesten" : "Business portrait photography in Budapest"
  : content.title;
const structuredData = isBusinessCategory
  ? {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://aureafotografia.hu/#website",
          url: "https://aureafotografia.hu/",
          name: photographer.brand,
          publisher: { "@id": "https://aureafotografia.hu/#photographer" },
          inLanguage: ["hu", "en"],
        },
        {
          "@type": "Person",
          "@id": "https://aureafotografia.hu/#photographer",
          name: photographer.name,
          jobTitle: isHungarian ? "Fotográfus" : "Photographer",
          url: "https://aureafotografia.hu/",
        },
        {
          "@type": "WebPage",
          "@id": `https://aureafotografia.hu${canonicalPath}#webpage`,
          url: `https://aureafotografia.hu${canonicalPath}`,
          name: content.title,
          description,
          inLanguage: locale,
          isPartOf: { "@id": "https://aureafotografia.hu/#website" },
          primaryImageOfPage: { "@id": `https://aureafotografia.hu${image}#primaryimage` },
          breadcrumb: { "@id": `https://aureafotografia.hu${canonicalPath}#breadcrumb` },
        },
        {
          "@type": "ProfessionalService",
          "@id": "https://aureafotografia.hu/#business-portrait-service",
          name: isHungarian ? "Aurea Fotográfia · Üzleti portré fotózás" : "Aurea Fotográfia · Business portrait photography",
          url: `https://aureafotografia.hu${canonicalPath}`,
          description,
          image: `https://aureafotografia.hu${image}`,
          provider: {
            "@type": "Person",
            name: photographer.name,
            jobTitle: isHungarian ? "Fotográfus" : "Photographer",
            worksFor: { "@type": "Organization", name: photographer.brand, url: "https://aureafotografia.hu/" },
          },
          areaServed: { "@type": "City", name: "Budapest" },
          serviceType: isHungarian ? ["Üzleti portré fotózás", "Business fotózás", "Personal branding fotózás"] : ["Business portrait photography", "Personal branding photography", "Corporate portrait photography"],
        },
        {
          "@type": "ImageObject",
          "@id": `https://aureafotografia.hu${image}#primaryimage`,
          contentUrl: `https://aureafotografia.hu${image}`,
          url: `https://aureafotografia.hu${image}`,
          caption: socialImageAlt,
          width: 2390,
          height: 3585,
        },
        {
          "@type": "BreadcrumbList",
          "@id": `https://aureafotografia.hu${canonicalPath}#breadcrumb`,
          itemListElement: [
            { "@type": "ListItem", position: 1, name: isHungarian ? "Kezdőlap" : "Home", item: `https://aureafotografia.hu${isHungarian ? "/" : "/en"}` },
            { "@type": "ListItem", position: 2, name: content.title, item: `https://aureafotografia.hu${canonicalPath}` },
          ],
        },
      ],
    }
  : undefined;
const packages = isBusinessPage
  ? [
      { name: "PROFILE", price: "39 000 HUF", description: "Néhány jól használható portré a szakmai megjelenésedhez.", includes: ["1 szett", "10 és 12 közötti szerkesztett fotó", "Online galéria"] },
      { name: "STANDARD", price: "59 000 HUF", description: "Több, mint egy portré: képek rólad és arról, ahogyan dolgozol.", includes: ["2 vagy 3 szett", "20 és 24 közötti szerkesztett fotó", "Online galéria"] },
      { name: "SIGNATURE", price: "79 000 HUF", description: "A teljes szakmai történeted képekben.", includes: ["TÖBB SZETT", "36+ SZERKESZTETT FOTÓ", "BUSINESS ÉS PERSONAL BRANDING KÉPEK", "ONLINE GALÉRIA"] },
    ]
  : isHungarian
  ? [
      { name: "Mini", price: "39 000 HUF", description: "Rövidebb, könnyed fotózás néhány fontos pillanatra.", includes: ["1 szett", "10–12 szerkesztett fotó", "Online galéria"] },
      { name: "Standard", price: "59 000 HUF", description: "A legnépszerűbb csomag egy teljesebb történethez.", includes: ["2–3 szett", "20–24 szerkesztett fotó", "Online galéria"] },
      { name: "Signature", price: "79 000 HUF", description: "Részletesebb jelenlét, több idő és több megőrzött emlék.", includes: ["Több szett", "36+ szerkesztett fotó", "Online galéria"] },
    ]
  : [
      { name: "Mini", price: "39 000 HUF", description: "A short, relaxed session for a few meaningful moments.", includes: ["1 outfit", "10–12 edited photographs", "Online gallery"] },
      { name: "Standard", price: "59 000 HUF", description: "The most popular package for a fuller story.", includes: ["2–3 outfits", "20–24 edited photographs", "Online gallery"] },
      { name: "Signature", price: "79 000 HUF", description: "More time, more presence and more of the story kept.", includes: ["Multiple outfits", "36+ edited photographs", "Online gallery"] },
    ];
const weddingPackages = [
  { name: "Kis csomag", title: "Szertartás fotózási csomag", description: "A szertartás megörökítése a választott helyszínen, csoportképekkel és egy rövid páros portréfotózással.", price: "109 000 Ft", includes: ["Szertartás", "Csoportképek", "Rövid páros portréfotózás", "2 fotós", "Legfeljebb 2 óra", "Egy helyszín", "100–300 fénykép", "Utazás 50 km-en belül"] },
  { name: "Közepes csomag", title: "Szertartás és ünneplés fotózási csomag", description: "Fotózás a szertartástól a mulatságig, csoportképekkel és egy rövid páros portréfotózással.", price: "269 000 Ft", includes: ["Szertartás", "Csoportképek", "Rövid páros portréfotózás", "Fogadás", "Mulatság", "2 fotós", "Legfeljebb 6 óra", "Legfeljebb 2 helyszín", "400–800 fénykép", "Utazás 50 km-en belül"] },
  { name: "Nagy csomag", title: "Egész napos esküvői fotózási csomag", description: "A teljes esküvői napot lefedő csomag, amely az előkészületek kulisszák mögötti pillanatait és egy teljes kreatív páros fotózást is tartalmaz.", price: "319 000 Ft", includes: ["Szertartás", "Csoportképek", "Fogadás", "Mulatság", "Előkészületek", "Teljes kreatív páros fotózás", "2 fotós", "Legfeljebb 10 óra", "Több helyszín", "600–1000 fénykép", "Utazás 50 km-en belül"] },
];
---

<SiteLayout locale={locale} title={pageTitle} description={description} canonicalPath={canonicalPath} alternatePath={alternatePath} socialImage={image} socialImageAlt={socialImageAlt} structuredData={structuredData}>
  <div class="site-shell category-shell">
    <SiteNav locale={locale} categorySlug={category.slug} />

    <main>
      <section class={`page-section category-reference-intro${isWeddingPage ? " category-reference-intro--wedding" : ""}`} aria-labelledby="category-title">
        <div class="page-section__inner">
          <div class="category-reference-intro__copy">
            <p class="eyebrow">{isBusinessPage ? "ÜZLETI PORTRÉ FOTÓZÁS · ÖNBIZALOM · HIVATÁS" : isWeddingPage ? "AUREA FOTOGRÁFIA · ESKÜVŐI TÖRTÉNETEK" : `${content.eyebrow} · ${content.meta}`}</p>
            <h1 id="category-title">{isWeddingPage ? <><span>Időtlen elegancia.</span><span>Őszinte pillanatok.</span><span>Valódi történetek.</span></> : content.title}</h1>
            {isWeddingPage ? (
              <>
                <p class="wedding-hero-tagline">Editorial és dokumentarista esküvői fotográfia, két alkotó szemszögéből.</p>
                <p class="wedding-hero-intro">Hiszem, hogy a legszebb esküvői fotók nem csupán megmutatnak egy pillanatot, hanem évekkel később is képesek visszaadni azt az érzést, amit akkor átéltetek.</p>
                <p class="wedding-hero-intro">Az esküvői fotózásban Aczél Dániellel, az Aether Art Space alkotójával dolgozom együtt. Két különböző látásmóddal, de közös szenvedéllyel meséljük el a történeteteket, természetesen, személyesen és művészi érzékenységgel.</p>
                <a class="button-link wedding-hero-cta" href="#category-contact">Meséljetek nekem a történetetekről!</a>
                <a class="wedding-gallery-link" href="#category-gallery">Ugrás a galériához</a>
              </>
            ) : <p>{isBusinessPage ? "Mert mielőtt megszólalnál, a képed már mesél rólad." : content.intro}</p>}
          </div>
          {isWeddingPage && <figure class="wedding-hero-image"><img src="/images/generated/galleries/eskuvo/dsc07129--full--318a1bda5f.jpg" alt="Színes, egész alakos esküvői portré a sziklák között, nyitott égbolttal" fetchpriority="high" /></figure>}
        </div>
      </section>

      <section class={`page-section category-story-section${isBusinessPage ? " category-business-story-section" : ""}`} aria-labelledby="category-story-title">
        <div class="page-section__inner category-story-layout">
          <div class="category-story-image">
            <img src={isWeddingPage ? "/images/generated/galleries/eskuvo/484--lina-zoli--full--da6571d55e.jpg" : image} alt={isWeddingPage ? "Lina és Zoli esküvői portréja a fák között" : content.title} loading="lazy" />
          </div>
          <div class="category-story-copy">
            <p class="eyebrow">{isBusinessPage ? "ELSŐ BENYOMÁS" : isWeddingPage ? "A fotográfia számomra értékteremtés" : isHungarian ? "A történetetek ritmusa" : "The rhythm of your story"}</p>
            <h2 id="category-story-title">{isBusinessPage ? "Szerinted számít az első benyomás?" : isWeddingPage ? "Ismerjetek meg!" : content.detail}</h2>
            {isBusinessPage ? (
              <>
                <p>És szerinted megtörténhet az első benyomás már online, vagy akár egy CV láttán?</p>
                <p>Én azt gondolom, hogy igen.</p>
                <p>A munkáltatók, az üzleti partnerek és a kliensek már azelőtt érzéseket és benyomásokat társítanak hozzánk, hogy egyáltalán találkoznánk velünk. A megjelenésünk az online térben, a LinkedIn profilunk, a CVnk vagy éppen egy rólunk készült fénykép mind hozzájárul ahhoz, milyen kép alakul ki rólunk.</p>
              </>
            ) : isWeddingPage ? (
              <>
                <p>Számomra a fotográfia sokkal több, mint gyönyörű képek készítése. Szenvedély, önkifejezés és mindenekelőtt értékteremtés.</p>
                <p>Azért választottam ezt az utat, mert szeretnék valami maradandót adni az embereknek. Olyan emlékeket, amelyek nem csupán ma szépek, hanem évtizedek múlva is jelentéssel bírnak.</p>
                <p><strong class="wedding-highlight">Minden pár más, és éppen ettől különleges minden történet.</strong></p>
                <p>Mielőtt a fényképezőgép mögé állnék, szeretnélek megismerni benneteket. Kíváncsi vagyok, hogyan találkoztatok, mi köt össze titeket, milyen a személyiségetek, és hogyan képzelitek el az esküvőtöket.</p>
                <p>Szeretem ezeket a beszélgetéseket, mert hiszem, hogy az igazán személyes képekhez először az embereket kell megismerni.</p>
                <p>Nem szeretnék rátok erőltetni egy előre meghatározott stílust. Fontos számomra, hogy a fotózás a ti ízlésetekhez, igényeitekhez és személyiségetekhez igazodjon, miközben a saját művészi látásmódommal teszem teljessé a történeteteket.</p>
                <p class="wedding-question"><strong>Milyen képeken szeretnétek viszontlátni magatokat? Elegáns, magazinba illő portrékon, spontán, érzelmekkel teli pillanatokban, vagy éppen a kettő különleges találkozásában?</strong></p>
                <a class="wedding-gallery-link" href="#category-gallery">Ugrás a galériához</a>
              </>
            ) : (
              <>
                <p>{content.intro}</p>
                <p class="category-story-meta">{content.meta}</p>
              </>
            )}
          </div>
        </div>
      </section>

      {isWeddingPage && <div class="wedding-editorial-sections">
        <section class="page-section wedding-feature-section">
          <div class="page-section__inner wedding-feature-layout">
            <figure class="wedding-feature-image"><img src="/images/generated/galleries/eskuvo/dsc07016--1200w--4080bcf9b0.jpg" alt="Meghitt, természetes esküvői pillanat" loading="lazy" /></figure>
            <div class="wedding-feature-copy">
              <p class="eyebrow">KÉT ALKOTÓ · KÉT NÉZŐPONT</p>
              <h2>Két alkotó. Két nézőpont. Egy közös szenvedély.</h2>
              <p>Az esküvői fotózásban Aczél Dániellel, az Aether Art Space budapesti fotóstúdió alkotójával dolgozom együtt.</p>
              <p>Mindkettőnk számára szenvedély a fotográfia. Közös munkánk alapja az alkotás szeretete, az egymást kiegészítő látásmód és az a törekvés, hogy valami igazán maradandót hozzunk létre.</p>
              <p>Két fotósként ugyanazt a történetet különböző perspektívákból mutathatjuk meg. Miközben egyikünk egy meghitt pillanatra figyel, a másik egy másik részletet, reakciót vagy érzelmet örökíthet meg.</p>
              <p>Így a napotok nem csupán események sorozataként, hanem teljes, sokszínű és személyes történetként elevenedhet meg a képeken.</p>
              <p><strong class="wedding-highlight">Két különböző látásmód, amely egyetlen történetté áll össze. A ti történeteteké.</strong></p>
              <a class="wedding-gallery-link" href="#category-gallery">Ugrás a galériához</a>
            </div>
          </div>
        </section>
        <section class="page-section wedding-feature-section wedding-feature-section--reverse">
          <div class="page-section__inner wedding-feature-layout">
            <div class="wedding-feature-copy">
              <p class="eyebrow">EDITORIAL ELEGANCIA · DOKUMENTARISTA TÖRTÉNETMESÉLÉS</p>
              <h2>Editorial elegancia és dokumentarista történetmesélés</h2>
              <p>Különösen közel áll hozzám az editorial fotográfia világa. Szeretem a divatfotózásból inspirálódó kompozíciókat, a fények játékát, az elegáns részleteket és az időtlen, művészi portrékat.</p>
              <p>De ami igazán feltölt, az a dokumentarista fotográfia: a pillanatok, amelyeket nem lehet megtervezni. Egy lopott pillantás, egy váratlan nevetés, egy meghatott ölelés vagy egy apró gesztus, amely talán mindenki másnak észrevétlen marad.</p>
              <p>Nem szeretném, hogy az esküvőtök egy egész napos, beállított fotózássá váljon. Azt szeretném, hogy megéljétek minden percét, miközben megörökítem mindazt, ami igazán fontos.</p>
              <p><strong class="wedding-highlight">Az editorial képek esztétikája és a dokumentarista fotográfia őszintesége együtt meséli el a történeteteket.</strong></p>
              <a class="wedding-gallery-link" href="#category-gallery">Ugrás a galériához</a>
            </div>
            <figure class="wedding-feature-image"><img src="/images/generated/galleries/eskuvo/dsc07466-edit--full--4565db82c2.jpg" alt="Roli és Kinga egymáshoz bújva, puha prémes kabátban" loading="lazy" /></figure>
          </div>
        </section>
        <section class="page-section wedding-memories-section">
          <div class="page-section__inner wedding-memories-layout">
            <div class="wedding-memories-inner">
              <p class="eyebrow">IDŐTÁLLÓ EMLÉKEK</p>
              <h2>Több mint fényképek. Emlékek, amelyek veletek maradnak.</h2>
              <p>Számomra a fotózás legnagyobb értéke az, hogy képes megőrizni valamit, ami egyébként visszahozhatatlan. Egy érzést. Egy találkozást. Egy ölelést. Egy olyan pillanatot, amelynek az igazi jelentőségét talán csak évekkel később értjük meg.</p>
              <p>Nem egyszerűen szép képeket szeretnék készíteni nektek. Olyan értéket szeretnék átadni, amelyet újra és újra elővehettek, amelyhez történetek kapcsolódnak, és amely egyszer majd a családotok történetének is része lesz.</p>
              <p><strong class="wedding-highlight">A legszebb képek nemcsak azt mutatják meg, hogyan nézett ki egy pillanat, hanem azt is, milyen érzés volt benne lenni.</strong></p>
              <p>Ha úgy érzitek, hogy ez a szemlélet közel áll hozzátok, meséljetek nekem a történetetekről. Örömmel ismerlek meg benneteket, és együtt megálmodhatjuk, hogyan meséljék el a képek a ti történeteteket.</p>
              <p class="wedding-signature"><span>Your Light. Your Story.</span></p>
              <a class="wedding-gallery-link" href="#category-gallery">Ugrás a galériához</a>
            </div>
            <figure class="wedding-memories-image"><img src="/images/generated/galleries/eskuvo/dsc06897--full--39bbf77681.jpg" alt="Közeli esküvői portré a fátyol finom mozdulatával" loading="lazy" /></figure>
          </div>
        </section>
      </div>}

      {isBusinessPage && (
        <div class="category-business-story">
          <section class="page-section category-business-story-section category-business-story-section--confidence" aria-labelledby="business-story-confidence">
            <div class="page-section__inner">
              <div class="category-business-story-copy">
                <p class="eyebrow">ÖNBIZALOM · HIVATÁS</p>
                <h3 id="business-story-confidence">Éppen ezért egy business portré számomra sokkal többről szól, mint egy jó profilképről.</h3>
                <p>Ahogy a közösségi médiában tudatosan válogatjuk meg, mit szeretnénk megmutatni magunkból, úgy a professzionális megjelenésünk is egyfajta vizuális kommunikáció.</p>
                <p>Megmutatja, kik vagyunk, mivel foglalkozunk, milyen értékeket képviselünk, és legfőképpen azt, hogyan szeretnénk jelen lenni a világban.</p>
                <p>Több mint tíz év szakmai és üzleti környezetben szerzett tapasztalatom alapján azt látom, hogy a megjelenésnek ma is fontos szerepe van.</p>
                <p>Nem azért, mert egy fényképnek mindent el kell mondania rólunk, hanem mert képes megteremteni azt az első kapcsolódási pontot, amelyre később a személyiségünk és a szakmai tudásunk épülhet.</p>
              </div>
            </div>
          </section>
          <section class="page-section category-business-story-section" aria-labelledby="business-story-authenticity">
            <div class="page-section__inner">
              <div class="category-business-story-copy">
                <h3 id="business-story-authenticity">A business fotózásban ezért szeretem azt megmutatni, ami valóban a tiéd.</h3>
                <p>Játszhatsz az öltözködéseddel, a környezettel, a gesztusokkal és a hangulattal, és mindezekkel finoman alakíthatod azt a képet, amit magadról szeretnél közvetíteni.</p>
                <p>Lehetsz elegáns, határozott, kreatív, közvetlen vagy éppen visszafogott.</p>
                <p>A cél nem az, hogy egy rád húzott üzleti szerepet játssz, hanem hogy a lehető legjobb és leghitelesebb formádban jelenj meg.</p>
              </div>
            </div>
          </section>
          <section class="page-section category-business-story-grid">
            <div class="page-section__inner category-business-story-grid__inner">
            <article class="category-business-story-section" aria-labelledby="business-story-confidence-effect">
              <div class="category-business-story-copy">
                <h3 id="business-story-confidence-effect">Amikor jól érzed magad abban, ahogyan megjelensz, az nem csupán a képeken látszik.</h3>
                <p>Magabiztosabbnak érzed magad.</p>
                <p>Erőt ad, hogy komfortosan vagy a saját bőrödben, és ez a magabiztosság a kisugárzásodon keresztül is megjelenik.</p>
              </div>
            </article>
            <article class="category-business-story-section category-business-story-section--closing" aria-labelledby="business-story-closing">
              <div class="category-business-story-copy">
                <h3 id="business-story-closing">Mielőtt megszólalnál, a képed már mesél rólad.</h3>
                <p>Egy állásinterjú, egy üzleti találkozó, egy új ügyfél vagy egy szakmai bemutatkozás esetében a professzionális megjelenés ennek fontos része lehet.</p>
              </div>
            </article>
            <article class="category-business-story-section category-business-story-gallery" aria-labelledby="gallery-title">
              <div class="category-business-story-copy">
                <h3 id="gallery-title">A szakmaiság mellett az ember is látszik.</h3>
                <p>Természetes, professzionális és használható képek rólad, a munkádról és arról, ahogyan jelen vagy a saját hivatásodban.</p>
              </div>
            </article>
            </div>
          </section>
        </div>
      )}

      <section class="page-section category-reference-gallery" id="category-gallery" aria-labelledby="gallery-title">
        <div class="page-section__inner">
          {!isBusinessPage && <div class="category-reference-gallery-heading">
            <p class="eyebrow">{isBusinessPage ? "GALÉRIA" : isHungarian ? "Válogatott képek" : "Selected images"}</p>
            <h2 id="gallery-title">{isBusinessPage ? "A szakmaiság mellett az ember is látszik." : isHungarian ? "A pillanatok, ahogy megtörténtek." : "The moments, exactly as they happened."}</h2>
            <p>{isBusinessPage ? "Természetes, professzionális és használható képek rólad, a munkádról és arról, ahogyan jelen vagy a saját hivatásodban." : content.detail}</p>
          </div>}
          <Gallery locale={locale} slug={category.slug} title={content.title} imageLabels={content.slots} />
        {!isBusinessPage && <p class="gallery-note">{category.slug === "eskuvo-fotozas" ? (isHungarian ? "Húzd a csempéket oldalra, vagy használd a nyilakat. Kattints egy fotóra a nagyításhoz." : "Drag the tiles sideways or use the arrows. Select a photograph to view it larger.") : (isHungarian ? "A galéria Alexandra válogatott munkáival frissül." : "The gallery will be refreshed with Alexandra’s selected work.")}</p>}
        </div>
      </section>

      <section class="page-section category-packages" aria-labelledby="category-packages-title">
        <div class="page-section__inner">
          <div class="category-packages-heading">
            <p class="eyebrow">{isHungarian ? "Csomagok" : "Packages"}</p>
            <h2 id="category-packages-title">{isBusinessPage ? "Válaszd azt, amelyik a szakmai jelenlétedhez illik." : isHungarian ? "Válasszátok azt, ami hozzátok illik." : "Choose what feels right for you."}</h2>
          </div>
          <div class="category-packages-grid">
            {(isWeddingPage ? weddingPackages : packages).map((pkg, index) => (
              <article class={`category-package-card${index === 1 ? " category-package-card--featured" : ""}`}>
                <h3>{pkg.name}</h3>
                {"title" in pkg && <h4 class="wedding-package-title">{pkg.title}</h4>}
                <p class="category-package-description">{pkg.description}</p>
                <p class="category-package-price">{pkg.price}</p>
                <div class="category-package-details">
                  <ul>
                    {pkg.includes.map((item) => <li>{item}</li>)}
                  </ul>
                  <a class="button-link" href="#category-contact">{isHungarian ? "Foglalás" : "Book now"}</a>
                </div>
              </article>
            ))}
          </div>
          {isWeddingPage && <a class="wedding-gallery-link wedding-package-gallery-link" href="#category-gallery">Ugrás a galériához</a>}
        </div>
      </section>

      {isWeddingPage && <section class="page-section wedding-seo-section">
        <div class="page-section__inner wedding-seo-copy">
          <p class="eyebrow">BUDAPEST · BALATON · ORSZÁGSZERTE</p>
          <h2>Esküvői fotózás Budapesten, a Balatonnál és országszerte</h2>
          <p>Az AUREA Fotográfia természetes, érzelmekben gazdag és művészi esküvői fotózást kínál Budapesten, a Balatonnál és Magyarország egész területén. Fotográfiai stílusom az editorial esküvői fotózás eleganciáját ötvözi a dokumentarista esküvőfotózás spontán, őszinte pillanataival.</p>
          <p>Szolgáltatásaim közé tartozik az esküvői fotózás, a kreatív esküvői fotózás, a jegyesfotózás, a páros fotózás és az intim esküvők megörökítése.</p>
          <p>Az esküvői fotózás során Aczél Dániellel, az Aether Art Space budapesti fotóstúdió alkotójával is együtt dolgozom. A kétfotós esküvői fotózás lehetőséget ad arra, hogy a nagy nap legfontosabb eseményeit, érzelmeit és apró részleteit több nézőpontból örökítsük meg.</p>
          <p>Ha természetes, romantikus, elegáns és időtálló esküvői képeket kerestek, keressetek bizalommal. Esküvői fotózás Budapesten, a Balaton környékén, vidéki és külföldi helyszíneken is, előzetes egyeztetés alapján.</p>
          <a class="wedding-gallery-link" href="#category-gallery">Ugrás a galériához</a>
        </div>
      </section>}

      {isBusinessPage && (
        <section class="page-section category-business-seo" aria-labelledby="business-seo-title">
          <div class="page-section__inner">
            <div class="category-business-seo__copy">
              <p class="eyebrow">TOVÁBBI INFORMÁCIÓ</p>
              <h2 id="business-seo-title">Business fotózás Budapesten</h2>
              <p>A professzionális business fotózás és üzleti portré fotózás segít abban, hogy magabiztosan és hitelesen jelenj meg a szakmai felületeken. Egy igényes üzleti portré használható LinkedIn profilképként, CVhez, céges bemutatkozáshoz, weboldalhoz, közösségi média felületekre vagy személyes márka építéséhez.</p>
              <p>A business portré fotózás során olyan természetes és professzionális képek készülnek, amelyek megmutatják a személyiségedet és illeszkednek a szakmai megjelenésedhez. A fotózás történhet Budapesten, stúdióban, irodában vagy kültéri helyszínen is.</p>
              <p>A personal branding fotózás, az üzleti portré és a céges portréfotózás különösen fontos lehet vállalkozók, cégvezetők, szakemberek, szabadúszók és olyan szolgáltatók számára, akiknek a személyes megjelenésük a szakmai márkájuk része.</p>
              <p>Ha professzionális LinkedIn profilképet, üzleti portrét, céges portréfotókat vagy personal branding képeket szeretnél, a business fotózás során olyan képsorozatot készítünk, amelyet hosszú távon is használhatsz a szakmai kommunikációd különböző felületein. Ez a vállalkozói fotózás és az üzleti fotózás egyik legfontosabb értéke.</p>
            </div>
          </div>
        </section>
      )}

      <ContactSection locale={locale} id="category-contact" buttonLabel={isBusinessPage ? "FOGLALÁS" : undefined} galleryLinkLabel={isWeddingPage ? "Ugrás a galériához" : undefined} galleryHref={isWeddingPage ? "#category-gallery" : undefined} />
    </main>

    <footer class="site-footer container">
      <div class="footer-row">
        <span class="footer-meta">Copyright 2026</span>
        <div class="footer-links">
          <span>{isHungarian ? "Kapcsolat:" : "Contact:"}</span>
          <a href={photographer.instagram} target="_blank" rel="noreferrer">instagram.com/aurea_fotografia_</a>
          <a href={`mailto:${photographer.email}`}>{photographer.email}</a>
        </div>
      </div>
    </footer>
  </div>
</SiteLayout>
